{
  "id": "pi-monitor",
  "name": "Pi Monitor",
  "version": "1.1.0",
  "description": "Shows the health of the Raspberry Pi running your display: CPU temperature, CPU usage, memory, disk, load, uptime and power/throttling warnings.",
  "author": "EE",
  "license": "MIT",
  "minAppVersion": "1.14.0",
  "moduleType": "pi-monitor",
  "category": "System",
  "icon": "cpu",
  "defaultConfig": {
    "refreshInterval": 5,
    "tempUnit": "auto",
    "warnTemp": 70,
    "critTemp": 80,
    "showTemperature": true,
    "showCpu": true,
    "showMemory": true,
    "showDisk": true,
    "showUptime": true,
    "showPowerStatus": true
  },
  "defaultSize": { "w": 400, "h": 320 },
  "exports": {
    "component": "default"
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "refreshInterval": {
        "type": "number",
        "title": "Refresh interval (seconds)",
        "minimum": 2,
        "maximum": 60,
        "ui:widget": "slider",
        "ui:step": 1
      },
      "tempUnit": {
        "type": "string",
        "title": "Temperature unit",
        "enum": ["auto", "C", "F"],
        "enumLabels": ["Follow display units", "Celsius", "Fahrenheit"],
        "ui:widget": "select"
      },
      "warnTemp": {
        "type": "number",
        "title": "Warning temperature (°C)",
        "minimum": 50,
        "maximum": 90,
        "ui:widget": "slider",
        "ui:step": 1,
        "ui:group": "Thresholds"
      },
      "critTemp": {
        "type": "number",
        "title": "Critical temperature (°C)",
        "minimum": 60,
        "maximum": 95,
        "ui:widget": "slider",
        "ui:step": 1,
        "ui:group": "Thresholds"
      },
      "showTemperature": { "type": "boolean", "title": "Show temperature", "ui:widget": "toggle", "ui:group": "Rows" },
      "showCpu": { "type": "boolean", "title": "Show CPU load", "ui:widget": "toggle", "ui:group": "Rows" },
      "showMemory": { "type": "boolean", "title": "Show memory", "ui:widget": "toggle", "ui:group": "Rows" },
      "showDisk": { "type": "boolean", "title": "Show disk", "ui:widget": "toggle", "ui:group": "Rows" },
      "showUptime": { "type": "boolean", "title": "Show uptime and load", "ui:widget": "toggle", "ui:group": "Rows" },
      "showPowerStatus": { "type": "boolean", "title": "Show power / throttling status", "ui:widget": "toggle", "ui:group": "Rows" }
    }
  },
  "settingsSchema": {
    "type": "object",
    "properties": {
      "statsUrl": {
        "type": "string",
        "title": "Stats URL (leave blank to use Home Screens' own stats)",
        "ui:widget": "text",
        "ui:placeholder": "http://192.168.68.145:3000/api/system/stats"
      }
    }
  },
  "providesState": [
    { "key": "temp_level", "label": "Pi temperature level", "sampleValues": ["ok", "warn", "critical"] },
    { "key": "throttled", "label": "Pi is throttled or under-volted", "sampleValues": ["true", "false"] }
  ],
  "permissions": ["network", "events", "localNetwork"],
  "allowedDomains": ["192.168.68.145", "localhost"]
}
